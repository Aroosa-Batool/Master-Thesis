# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Espruino tooling (if used)
node_modules/
*.log

# IDE / editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build / dist
dist/
build/

# Local config and secrets
.env
.env.*
!.env.example
*.local

# Thesis-specific local artifacts
data/raw/
data/recordings/
*.bak

# Ohbot SDK runtime cache. The SDK writes ohbotData/ into the current
# working directory at runtime (TTS .wav cache, settings, etc.). Ignore
# the root-level copy; the canonical templates live in ohbot/ohbotData/.
/ohbotData/
# Generated TTS output the ohbot SDK writes into the CWD on each say().
ohbotspeech.wav

# All runtime state lives under robot/state/ (see robot/paths.py) and is user
# data / auto-downloaded weights, never source: the face + voice bystander
# galleries, the per-modality consent caches, the owner face/voice enrollments,
# the reminders list, and the ~37 MB YuNet/SFace ONNX weights that
# face_id.ensure_models() downloads on first run. Ignore the whole directory.
robot/state/

# Algorithm-comparison benchmark (robot/bench/): downloaded challenger model
# weights (SSD caffemodel, BlazeFace tflite, SpeechBrain/InsightFace caches) and
# the user-recorded eval set (faces/voices - personal data). The bench scripts
# and committed results/*.csv|md stay tracked.
robot/bench/models/
robot/bench/eval_data/
