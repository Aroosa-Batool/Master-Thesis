# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Espruino tooling (if used)
node_modules/
*.log

# IDE / editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build / dist
dist/
build/

# Local config and secrets
.env
.env.*
!.env.example
*.local

# Thesis-specific local artifacts
data/raw/
data/recordings/
*.bak

# Ohbot SDK runtime cache. The SDK writes ohbotData/ into the current
# working directory at runtime (TTS .wav cache, settings, etc.). Ignore
# the root-level copy; the canonical templates live in ohbot/ohbotData/.
/ohbotData/
# Generated TTS output the ohbot SDK writes into the CWD on each say().
ohbotspeech.wav

# Face recognition: ONNX model weights (~37MB) auto-downloaded by
# face_id.ensure_models() on first run, and the runtime face-identity
# gallery + consent cache + owner enrollment (user data, not source).
interface/presence/models/
interface/presence/face_db.json
interface/presence/consent_cache.json
interface/presence/owner_face.json

# Voice modality: runtime speaker-identity gallery + consent cache + owner
# voice enrollment (user data, not source). Resemblyzer's model weights ship
# inside the pip package, so there is nothing to ignore for those.
interface/presence/voice_db.json
interface/presence/consent_cache_voice.json
interface/presence/owner_voice.json
